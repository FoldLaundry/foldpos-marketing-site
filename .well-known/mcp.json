{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "com.foldpos/fold-pos",
  "title": "Fold POS",
  "description": "Public, read-only facts about Fold POS, the point of sale for laundromats, dry cleaners and tailors: pricing, features, supported printers, switching from another system, getting started and contact. No auth, no store data.",
  "version": "0.0.1",
  "websiteUrl": "https://foldpos.com/developers",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.foldpos.com/v1/mcp"
    }
  ],
  "_meta": {
    "com.foldpos/discovery": {
      "authentication": "none",
      "readOnly": true,
      "languages": [
        "en",
        "es"
      ],
      "areaServed": "The Americas, except Cuba",
      "tools": [
        "about_fold_pos",
        "pricing_plans",
        "features",
        "availability",
        "supported_hardware",
        "switching_from",
        "getting_started",
        "faq",
        "site_page",
        "contact"
      ],
      "resources": [
        "foldpos://llms.txt",
        "foldpos://llms-full.txt",
        "foldpos://pages/{language}/{page}.md"
      ],
      "documentation": "https://foldpos.com/developers.md",
      "llms": "https://foldpos.com/llms.txt",
      "contact": "contact@foldpos.com",
      "prompts": [
        "recommend_plan",
        "explain_fold_pos_es"
      ]
    },
    "com.foldpos/servers": [
      {
        "name": "com.foldpos/fold-pos-store",
        "title": "Fold POS store",
        "description": "A store owner's own AI assistant, connected to one Fold POS store: sales, orders, customers, machines, supplies, pickups and deliveries, and staff. Look-only unless the owner switches on three small changes, each previewed first. Requires authorization: the owner signs in and approves inside Fold POS (OAuth 2.1 with PKCE), or sends a personal token as a Bearer header.",
        "websiteUrl": "https://foldpos.com/developers#store-mcp",
        "remotes": [
          {
            "type": "streamable-http",
            "url": "https://app.foldpos.com/v1/mcp/store",
            "headers": [
              {
                "name": "Authorization",
                "description": "Bearer token: an access token from the OAuth sign-in, or a personal token the store owner created in Fold POS (Settings › Assistants).",
                "isRequired": true,
                "isSecret": true
              }
            ]
          }
        ],
        "_meta": {
          "com.foldpos/discovery": {
            "authentication": "oauth2",
            "authorizationRequired": true,
            "oauth": {
              "protectedResourceMetadata": "https://app.foldpos.com/.well-known/oauth-protected-resource/v1/mcp/store",
              "authorizationServerMetadata": "https://app.foldpos.com/.well-known/oauth-authorization-server",
              "scopes": [
                "read",
                "write"
              ],
              "codeChallengeMethods": [
                "S256"
              ]
            },
            "alsoAccepts": "A personal token (fpos_pat_…) sent as a Bearer header",
            "readOnly": false,
            "readOnlyByDefault": true,
            "tools": [
              "store_overview",
              "today",
              "needs_attention",
              "find_orders",
              "order_detail",
              "ready_not_picked_up",
              "find_customers",
              "customer_detail",
              "sales_report",
              "machines",
              "supplies_low",
              "deliveries",
              "staff_on_shift",
              "mark_order_ready",
              "add_order_note",
              "add_customer_note"
            ],
            "changeTools": [
              "mark_order_ready",
              "add_order_note",
              "add_customer_note"
            ],
            "documentation": "https://foldpos.com/developers.md",
            "help": "https://foldpos.com/assistants",
            "contact": "contact@foldpos.com"
          }
        }
      },
      {
        "name": "com.foldpos/fold-pos-booking",
        "title": "Fold POS pickup booking",
        "description": "A customer's own AI assistant books a laundry pickup with a shop that has online booking switched on, with the same rules, times and prices as the shop's booking page. Open: no sign-in. The customer confirms with a 6-digit code texted to their phone before anything is written. Nothing is charged at booking.",
        "websiteUrl": "https://foldpos.com/developers#booking-mcp",
        "remotes": [
          {
            "type": "streamable-http",
            "url": "https://app.foldpos.com/v1/mcp/book"
          }
        ],
        "_meta": {
          "com.foldpos/discovery": {
            "authentication": "none",
            "authorizationRequired": false,
            "readOnly": false,
            "tools": [
              "find_shop",
              "shop_info",
              "pickup_times",
              "return_options",
              "send_booking_code",
              "book_pickup",
              "my_booking",
              "booking_move_times",
              "move_booking",
              "cancel_booking"
            ],
            "writeTools": [
              "send_booking_code",
              "book_pickup",
              "move_booking",
              "cancel_booking"
            ],
            "documentation": "https://foldpos.com/developers.md",
            "contact": "contact@foldpos.com"
          }
        }
      }
    ]
  }
}
